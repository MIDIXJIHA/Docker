# RapidKL API Configuration
RAPIDKL_API_KEY=your_api_key_from_developer_data_gov_my
RAPIDKL_API_BASE_URL=https://developer.data.gov.my

# Backend Configuration
NODE_ENV=development
PORT=5001
CACHE_ENABLED=true
CACHE_TTL=300

# Frontend Configuration
REACT_APP_API_URL=http://localhost:5001/api

# Optional: Mapbox for advanced mapping features
MAPBOX_TOKEN=your_mapbox_token_optional
